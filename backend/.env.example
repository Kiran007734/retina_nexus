APP_NAME=RETINA-NEXUS
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
MODEL_DIRECTORY=../ml/weights
DATA_DIRECTORY=../ml/datasets
UPLOAD_DIRECTORY=./storage
DATABASE_URL=sqlite+aiosqlite:///./retina_nexus.db
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=15
ALLOWED_IMAGE_MIME_TYPES=["image/jpeg","image/png"]
DEMO_MODE_ENABLED=false
CLASSIFIER_MODEL_PATH=../ml/weights/classifiers/aptos2019/efficientnet-b0-aptos2019-20260830-v1/checkpoint_best.pt
CLASSIFIER_BACKBONE=efficientnet_b0
CLASSIFIER_MODEL_VERSION=efficientnet-b0-aptos2019-20260830-v1
CLASSIFIER_DEVICE=cpu
REFERABLE_MIN_GRADE=2
EVIDENCE_ENABLE_HEURISTICS=true
EVIDENCE_MAX_DIMENSION=768
LESION_MODEL_PATH=../ml/weights/lesion_segmentation/fundus-lesions-unet-seresnext50-all-v1/model.safetensors
LESION_MODEL_VERSION=fundus-lesions-unet-seresnext50-all-v1
LESION_MODEL_DEVICE=auto
LESION_MODEL_THRESHOLD=0.5
EVIDENCE_ENABLE_VESSEL_BASELINE=false
VESSEL_MODEL_PATH=../ml/weights/vessel_segmentation/r2-v2-bv-2025/bv.safetensors
VESSEL_MODEL_VERSION=r2-v2-bv-2025
VESSEL_MODEL_DEVICE=auto
VESSEL_MODEL_THRESHOLD=0.5
EXPLAINABILITY_STABILITY_ENABLED=false
EXPLAINABILITY_COUNTERFACTUAL_ENABLED=false
EXPLAINABILITY_MAX_STABILITY_VARIANTS=3
RETINAGUARD_CONFIG_VERSION=retinaguard-v1
RETINAGUARD_TEMPERATURE=1.0
RETINAGUARD_CALIBRATION_VERSION=temperature-scaling-unfitted
RETINAGUARD_CALIBRATION_FITTED=false
RETINAGUARD_OOD_REFERENCE_PATH=
RETINAGUARD_OOD_THRESHOLD=3.0
RETINAGUARD_MISSING_SIGNAL_SCORE=0.25
RETINAGUARD_TRUSTED_THRESHOLD=0.75
RETINAGUARD_UNRELIABLE_THRESHOLD=0.45
RETINAGUARD_WEIGHT_QUALITY=0.20
RETINAGUARD_WEIGHT_CALIBRATED_CONFIDENCE=0.20
RETINAGUARD_WEIGHT_UNCERTAINTY=0.15
RETINAGUARD_WEIGHT_MODEL_AGREEMENT=0.10
RETINAGUARD_WEIGHT_LESION_EVIDENCE=0.10
RETINAGUARD_WEIGHT_ATTENTION_LESION_AGREEMENT=0.15
RETINAGUARD_WEIGHT_EXPLANATION_STABILITY=0.05
RETINAGUARD_WEIGHT_OOD=0.05
RETINAGUARD_MC_DROPOUT_ENABLED=false
RETINAGUARD_MC_DROPOUT_SAMPLES=8
